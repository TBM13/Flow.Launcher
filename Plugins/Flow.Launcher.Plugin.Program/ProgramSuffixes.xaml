<Window
    x:Class="Flow.Launcher.Plugin.Program.ProgramSuffixes"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:root="clr-namespace:Flow.Launcher.Plugin.Program"
    Title="{x:Static root:Localize.Settings_ProgramSuffixes}"
    Width="600"
    Background="{DynamicResource PopuBGColor}"
    DataContext="{Binding RelativeSource={RelativeSource Self}}"
    Foreground="{DynamicResource PopupTextColor}"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    WindowStyle="ToolWindow">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="SettingGroupBoxToolTip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Color00B}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Color03B}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Margin" Value="0 5 0 0" />
            <Setter Property="Padding" Value="15 15 15 15" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
    </Window.Resources>

    <Grid x:Name="WindowArea">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="80" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="26 12 26 0">
            <StackPanel Margin="0 0 0 12">

                <TextBlock
                    Grid.Column="0"
                    Margin="0 0 0 0"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="{x:Static root:Localize.Settings_ProgramSuffixes}"
                    TextAlignment="Left" />
            </StackPanel>
            <TextBlock
                Margin="0 0 0 10"
                FontSize="14"
                TextWrapping="Wrap" />
            <Border Style="{StaticResource SettingGroupBoxToolTip}" Visibility="{Binding IsFocused, ElementName=tbProtocols, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock
                    FontSize="14"
                    Text="{x:Static root:Localize.Settings_ProtocolTooltip}"
                    TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource SettingGroupBoxToolTip}" Visibility="{Binding IsFocused, ElementName=tbSuffixes, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock
                    FontSize="14"
                    Text="{x:Static root:Localize.Settings_SuffixesTooltip}"
                    TextWrapping="Wrap" />
            </Border>

            <Grid Margin="0 20 0 12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="250" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0 0 0 0">
                    <TextBlock
                        Margin="0 0 0 8"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="{x:Static root:Localize.Settings_SuffixesExecutableTypes}" />
                    <CheckBox
                        Name="apprefMS"
                        Margin="10 0 0 0"
                        IsChecked="{Binding SuffixesStatus[appref-ms]}">
                        appref-ms
                    </CheckBox>
                    <CheckBox
                        Name="exe"
                        Margin="10 0 0 0"
                        IsChecked="{Binding SuffixesStatus[exe]}">
                        exe
                    </CheckBox>
                    <CheckBox
                        Name="lnk"
                        Margin="10 0 0 0"
                        IsChecked="{Binding SuffixesStatus[lnk]}">
                        lnk
                    </CheckBox>
                    <CheckBox
                        Name="CustomFiles"
                        Margin="10 0 0 0"
                        Content="{x:Static root:Localize.Settings_SuffixesCustomFileTypes}"
                        IsChecked="{Binding UseCustomSuffixes}" />
                    <TextBox
                        x:Name="tbSuffixes"
                        Margin="10 4 0 10"
                        Style="{StaticResource DefaultTextBoxStyle}"
                        Visibility="{Binding IsChecked, ElementName=CustomFiles, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <Border
                    Grid.Column="1"
                    Margin="20 0 0 10"
                    Padding="20 0 0 0"
                    BorderBrush="{DynamicResource PopupButtonAreaBorderColor}"
                    BorderThickness="1 0 0 0">
                    <StackPanel>
                        <TextBlock
                            Margin="0 0 0 8"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="{x:Static root:Localize.Settings_SuffixesURLTypes}" />
                        <CheckBox
                            Name="steam"
                            Margin="10 0 0 0"
                            Content="{x:Static root:Localize.Settings_SuffixesURLSteam}"
                            IsChecked="{Binding ProtocolsStatus[steam]}" />
                        <CheckBox
                            Name="epic"
                            Margin="10 0 0 0"
                            Content="{x:Static root:Localize.Settings_SuffixesURLEpic}"
                            IsChecked="{Binding ProtocolsStatus[epic]}" />
                        <CheckBox
                            Name="http"
                            Margin="10 0 0 0"
                            Content="{x:Static root:Localize.Settings_SuffixesURLHttp}"
                            IsChecked="{Binding ProtocolsStatus[http]}" />
                        <CheckBox
                            Name="CustomProtocol"
                            Margin="10 0 0 0"
                            Content="{x:Static root:Localize.Settings_SuffixesCustomUrls}"
                            IsChecked="{Binding UseCustomProtocols}" />
                        <TextBox
                            x:Name="tbProtocols"
                            Margin="10 4 0 0"
                            Style="{StaticResource DefaultTextBoxStyle}"
                            Visibility="{Binding IsChecked, ElementName=CustomProtocol, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
        <Border
            Grid.Row="1"
            Background="{DynamicResource PopupButtonAreaBGColor}"
            BorderBrush="{DynamicResource PopupButtonAreaBorderColor}"
            BorderThickness="0 1 0 0">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Button
                    x:Name="btnReset"
                    Height="30"
                    MinWidth="140"
                    Margin="0 0 5 0"
                    Click="BtnReset_OnClick"
                    Content="{x:Static root:Localize.Settings_ResetDefault}" />
                <Button
                    x:Name="btnCancel"
                    Height="30"
                    MinWidth="140"
                    Margin="5 0 5 0"
                    Click="BtnCancel_OnClick"
                    Content="Cancel" />

                <Button
                    Height="30"
                    MinWidth="140"
                    Margin="5 0 0 0"
                    HorizontalAlignment="Right"
                    Click="BtnAdd_OnClick"
                    Content="{x:Static root:Localize.Settings_Update}"
                    Style="{DynamicResource AccentButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>







