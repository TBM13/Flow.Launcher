<UserControl
    x:Class="Flow.Launcher.Plugin.WindowsDevices.Settings.SettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Flow.Launcher.Plugin.WindowsDevices.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pluginsdk="http://schemas.flowlauncher.com/pluginsdk"
    d:DataContext="{d:DesignInstance Type=local:SettingsViewModel}"
    d:DesignHeight="300"
    d:DesignWidth="500"
    mc:Ignorable="d">

    <StackPanel>
        <pluginsdk:SettingsCard
            Description="Show non-present and hidden devices in search results."
            Header="Show hidden devices">
            <pluginsdk:ToggleSwitch IsOn="{Binding Settings.ShowHiddenDevices}" />
        </pluginsdk:SettingsCard>
    </StackPanel>
</UserControl>
