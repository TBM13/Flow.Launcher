<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:String x:Key="plugin_windowstasks_plugin_name">Windows Tasks</system:String>
    <system:String x:Key="plugin_windowstasks_plugin_description">Manage Windows tasks from Flow Launcher</system:String>

    <!-- Task States -->
    <system:String x:Key="plugin_windowstasks_taskState">State: {0}</system:String>
    <system:String x:Key="plugin_windowstasks_taskState_disabled">Disabled</system:String>
    <system:String x:Key="plugin_windowstasks_taskState_queued">Queued</system:String>
    <system:String x:Key="plugin_windowstasks_taskState_ready">Ready</system:String>
    <system:String x:Key="plugin_windowstasks_taskState_running">Running</system:String>
    <system:String x:Key="plugin_windowstasks_taskState_unknown">Unknown</system:String>

    <!-- Task Run Times -->
    <system:String x:Key="plugin_windowstasks_lastRunTime">Last run: {0}</system:String>
    <system:String x:Key="plugin_windowstasks_nextRunTime">Next run: {0}</system:String>

</ResourceDictionary>