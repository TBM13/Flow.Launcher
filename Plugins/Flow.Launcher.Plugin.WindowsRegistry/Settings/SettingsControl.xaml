<UserControl
    x:Class="Flow.Launcher.Plugin.WindowsRegistry.Settings.SettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Flow.Launcher.Plugin.WindowsRegistry.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    d:DataContext="{d:DesignInstance Type=local:SettingsViewModel}"
    d:DesignHeight="300"
    d:DesignWidth="500"
    mc:Ignorable="d">

    <StackPanel>
        <ui:SettingsCard
            Description="Path to Sysinternals regjump.exe used to open registry keys and values."
            Header="RegJump executable path">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <TextBox
                    MinWidth="260"
                    VerticalAlignment="Center"
                    Text="{Binding Settings.RegJumpPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Margin="8 0 0 0"
                    VerticalAlignment="Center"
                    Click="BrowseButton_Click"
                    Content="Browse..." />
            </StackPanel>
        </ui:SettingsCard>
    </StackPanel>
</UserControl>
