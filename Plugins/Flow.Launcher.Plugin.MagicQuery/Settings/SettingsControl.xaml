<UserControl
    x:Class="Flow.Launcher.Plugin.MagicQuery.Settings.SettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Flow.Launcher.Plugin.MagicQuery.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pluginsdk="http://schemas.flowlauncher.com/pluginsdk"
    d:DataContext="{d:DesignInstance Type=local:SettingsViewModel}"
    d:DesignHeight="350"
    d:DesignWidth="650"
    mc:Ignorable="d">

    <StackPanel>
        <pluginsdk:SettingsCard Description="Evaluated top to bottom against the active window." Header="Rules">
            <Button
                Command="{Binding AddRuleCommand}"
                Content="Add Rule"
                Style="{DynamicResource AccentButtonStyle}" />
        </pluginsdk:SettingsCard>

        <TextBlock
            Margin="16 14 16 10"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="No rules configured."
            TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Settings.Rules.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ItemsControl Margin="16 10 16 2" ItemsSource="{Binding Settings.Rules}">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Settings.Rules.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:MagicQueryRule}">
                    <Border
                        Margin="0 0 0 8"
                        Padding="14"
                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel>
                            <DockPanel Margin="0 0 0 10" LastChildFill="False">
                                <CheckBox
                                    MinWidth="0"
                                    VerticalAlignment="Center"
                                    Content="Enabled"
                                    DockPanel.Dock="Left"
                                    IsChecked="{Binding Enabled, Mode=TwoWay}" />

                                <StackPanel
                                    VerticalAlignment="Center"
                                    DockPanel.Dock="Right"
                                    Orientation="Horizontal">
                                    <Button
                                        Margin="0 0 4 0"
                                        Padding="7"
                                        Command="{Binding DataContext.MoveRuleUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Move up">
                                        <pluginsdk:FontIcon FontSize="12" Glyph="&#xe70e;" />
                                    </Button>
                                    <Button
                                        Margin="0 0 4 0"
                                        Padding="7"
                                        Command="{Binding DataContext.MoveRuleDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Move down">
                                        <pluginsdk:FontIcon FontSize="12" Glyph="&#xe70d;" />
                                    </Button>
                                    <Button
                                        Padding="7"
                                        Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Delete rule">
                                        <pluginsdk:FontIcon FontSize="12" Glyph="&#xe74d;" />
                                    </Button>
                                </StackPanel>
                            </DockPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!--  Window Title  -->
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0 0 12 8"
                                    VerticalAlignment="Center"
                                    Text="Window Title" />
                                <TextBox
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="0 0 8 8"
                                    VerticalAlignment="Center"
                                    pluginsdk:TextBoxHelper.PlaceholderText="Leave empty to ignore"
                                    Text="{Binding WindowTitlePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    MinWidth="95"
                                    Margin="0 0 8 8"
                                    VerticalAlignment="Center"
                                    ItemsSource="{x:Static local:SettingsViewModel.MatchTypeItems}"
                                    SelectedValue="{Binding WindowTitleMatchType, Mode=TwoWay}"
                                    SelectedValuePath="Value" />
                                <CheckBox
                                    Grid.Row="0"
                                    Grid.Column="3"
                                    MinWidth="0"
                                    Margin="0 0 0 8"
                                    VerticalAlignment="Center"
                                    Content="Case sensitive"
                                    IsChecked="{Binding WindowTitleCaseSensitive, Mode=TwoWay}" />

                                <!--  Process Path  -->
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0 0 12 8"
                                    VerticalAlignment="Center"
                                    Text="Process Path" />
                                <DockPanel
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0 0 8 8"
                                    LastChildFill="True">
                                    <Button
                                        Margin="6 0 0 0"
                                        VerticalAlignment="Center"
                                        Click="BrowseButton_Click"
                                        Content="Browse..."
                                        DockPanel.Dock="Right" />
                                    <TextBox
                                        VerticalAlignment="Center"
                                        pluginsdk:TextBoxHelper.PlaceholderText="Leave empty to ignore>"
                                        Text="{Binding ProcessPathPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                                <ComboBox
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    MinWidth="95"
                                    Margin="0 0 8 8"
                                    VerticalAlignment="Center"
                                    ItemsSource="{x:Static local:SettingsViewModel.MatchTypeItems}"
                                    SelectedValue="{Binding ProcessPathMatchType, Mode=TwoWay}"
                                    SelectedValuePath="Value" />
                                <CheckBox
                                    Grid.Row="1"
                                    Grid.Column="3"
                                    MinWidth="0"
                                    Margin="0 0 0 8"
                                    VerticalAlignment="Center"
                                    Content="Case sensitive"
                                    IsChecked="{Binding ProcessPathCaseSensitive, Mode=TwoWay}" />

                                <!--  Return Query  -->
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="0 0 12 0"
                                    VerticalAlignment="Center"
                                    Text="Return Query" />
                                <TextBox
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="3"
                                    VerticalAlignment="Center"
                                    pluginsdk:TextBoxHelper.PlaceholderText="Query to return (supports $1, $2, ${name} when using Regex)"
                                    Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
