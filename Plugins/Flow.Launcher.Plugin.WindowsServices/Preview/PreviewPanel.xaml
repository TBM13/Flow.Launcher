<UserControl
    x:Class="Flow.Launcher.Plugin.WindowsServices.Preview.PreviewPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Flow.Launcher.Plugin.WindowsServices.Preview"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Margin="0 3 3 0"
    d:DesignHeight="300"
    d:DesignWidth="300"
    mc:Ignorable="d">
    <Grid>
        <ScrollViewer Margin="0 0 0 30" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0 0 3 0">
                <TextBlock
                    x:Name="TitleTextblock"
                    Margin="0 5 0 0"
                    Style="{DynamicResource PreviewItemTitleStyle}"
                    Text="Service Title"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="DescriptionTextblock"
                    Margin="0 5 0 0"
                    Style="{DynamicResource PreviewItemSubTitleStyle}"
                    Text="Service description."
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <TextBlock
            x:Name="PathTextblock"
            Height="18"
            Margin="0 0 0 3"
            VerticalAlignment="Bottom"
            Style="{DynamicResource PreviewItemSubTitleStyle}"
            Text="Service Path"
            TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>