<UserControl x:Class="Flow.Launcher.Plugin.WindowsServices.Preview.PreviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Flow.Launcher.Plugin.WindowsServices.Preview"
             mc:Ignorable="d"
             Margin="0,3,3,0"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <ScrollViewer 
            VerticalScrollBarVisibility="Auto"
            Margin="0,0,0,30">
            <StackPanel Margin="0,0,3,0">
                <TextBlock 
                     x:Name="TitleTextblock"
                     Margin="0,5,0,0"
                     Text="Service Title" 
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     Style="{DynamicResource PreviewItemTitleStyle}"/>
                <TextBlock 
                     x:Name="DescriptionTextblock" 
                     Margin="0,5,0,0"
                     Text="Service description."
                     TextWrapping="Wrap"
                     Style="{DynamicResource PreviewItemSubTitleStyle}"/>
            </StackPanel>
        </ScrollViewer>

        <TextBlock
                x:Name="PathTextblock"
                VerticalAlignment="Bottom"
                Margin="0,0,0,3"
                Height="18" 
                Text="Service Path"
                TextTrimming="CharacterEllipsis"
                Style="{DynamicResource PreviewItemSubTitleStyle}"/>
        </Grid>
</UserControl>
