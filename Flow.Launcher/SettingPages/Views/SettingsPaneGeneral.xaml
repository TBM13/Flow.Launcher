<ui:Page
    x:Class="Flow.Launcher.SettingPages.Views.SettingsPaneGeneral"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Flow.Launcher.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:Flow.Launcher.Resources.MarkupExtensions"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="clr-namespace:Flow.Launcher.Core.Settings;assembly=Flow.Launcher.Core"
    xmlns:settingsViewModels="clr-namespace:Flow.Launcher.SettingPages.ViewModels"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    Title="General"
    d:DataContext="{d:DesignInstance settingsViewModels:SettingsPaneGeneralViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <ui:Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </ui:Page.Resources>
    <ui:ScrollViewerEx
        FontSize="14"
        VirtualizingPanel.ScrollUnit="Pixel"
        VirtualizingStackPanel.IsVirtualizing="True">
        <VirtualizingStackPanel Margin="5 18 25 30" Orientation="Vertical">
            <TextBlock
                Grid.Row="2"
                Margin="0 5"
                FontSize="30"
                Text="General"
                TextAlignment="left" />

            <ui:SettingsCard Description="Flow Launcher search window is hidden in the tray after starting up." Header="Hide Flow Launcher on startup">
                <ui:SettingsCard.HeaderIcon>
                    <ui:FontIcon Glyph="&#xed1a;" />
                </ui:SettingsCard.HeaderIcon>

                <ui:ToggleSwitch
                    IsOn="{Binding Settings.HideOnStartup}"
                    OffContent="Off"
                    OnContent="On" />
            </ui:SettingsCard>

            <ui:SettingsCard
                Margin="0 4 0 0"
                Description="Run Flow Launcher as administrator on startup"
                Header="Always run as administrator">
                <ui:SettingsCard.HeaderIcon>
                    <ui:FontIcon Glyph="&#xE7EF;" />
                </ui:SettingsCard.HeaderIcon>

                <ui:ToggleSwitch
                    IsOn="{Binding AlwaysRunAsAdmin}"
                    OffContent="Off"
                    OnContent="On" />
            </ui:SettingsCard>

            <ui:SettingsCard Margin="0 12 0 0" Header="Hide Flow Launcher when focus is lost">
                <ui:ToggleSwitch
                    IsOn="{Binding Settings.HideOnLostFocus}"
                    OffContent="Off"
                    OnContent="On" />
            </ui:SettingsCard>

            <ui:SettingsCard
                Margin="0 4 0 0"
                Description="Temporarily show the taskbar when Flow Launcher is opened, useful for auto-hidden taskbars."
                Header="Show taskbar when Flow Launcher is opened">
                <ui:ToggleSwitch
                    IsOn="{Binding Settings.ShowTaskbarWhenOpened}"
                    OffContent="Off"
                    OnContent="On" />
            </ui:SettingsCard>

            <ui:SettingsCard
                Margin="0 14 0 0"
                Description="Overrides other programs' 'Always on Top' setting and displays Flow in the foremost position."
                Header="Show Search Window at Foremost">
                <ui:SettingsCard.HeaderIcon>
                    <ui:FontIcon Glyph="&#xf5ed;" />
                </ui:SettingsCard.HeaderIcon>

                <ui:ToggleSwitch
                    IsOn="{Binding Settings.ShowAtTopmost}"
                    OffContent="Off"
                    OnContent="On" />
            </ui:SettingsCard>

            <ui:SettingsCard Margin="0 4 0 0" Header="Search Window Location">
                <ui:SettingsCard.HeaderIcon>
                    <ui:FontIcon Glyph="&#xe7f4;" />
                </ui:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal">
                    <ComboBox
                        MinWidth="220"
                        VerticalAlignment="Center"
                        DisplayMemberPath="Description"
                        FontSize="14"
                        ItemsSource="{Binding Display}"
                        SelectedValue="{Binding Settings.Display}"
                        SelectedValuePath="Value" />
                    <ComboBox
                        MinWidth="160"
                        Margin="18 0 0 0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        ItemsSource="{Binding ScreenNumbers}"
                        SelectedValue="{Binding Settings.DisplayNumber}"
                        Visibility="{ext:VisibleWhen {Binding Settings.Display},
                                                     IsEqualTo={x:Static settings:DisplayType.Custom}}" />
                </StackPanel>
            </ui:SettingsCard>

            <ui:SettingsCard
                Margin="0 4 0 0"
                Header="Search Window Position on Monitor"
                Visibility="{ext:CollapsedWhen {Binding Settings.Display},
                                               IsEqualTo={x:Static settings:DisplayType.RememberLastDisplay}}">
                <ui:SettingsCard.HeaderIcon>
                    <ui:FontIcon Glyph="&#xe7f4;" />
                </ui:SettingsCard.HeaderIcon>

                <StackPanel Orientation="Horizontal">
                    <ComboBox
                        MinWidth="160"
                        VerticalAlignment="Center"
                        DisplayMemberPath="Description"
                        FontSize="14"
                        ItemsSource="{Binding DisplayPositions}"
                        SelectedValue="{Binding Settings.DisplayPosition}"
                        SelectedValuePath="Value" />

                    <StackPanel
                        Margin="18 0 0 0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{ext:VisibleWhen {Binding Settings.DisplayPosition},
                                                     IsEqualTo={x:Static settings:DisplayPosition.Custom}}">
                        <TextBox
                            MinWidth="80"
                            VerticalAlignment="Center"
                            Text="{Binding Settings.CustomDisplayPositionLeft}" />
                        <TextBlock
                            Margin="10"
                            VerticalAlignment="Center"
                            Text="x" />
                        <TextBox
                            MinWidth="80"
                            VerticalAlignment="Center"
                            Text="{Binding Settings.CustomDisplayPositionTop}"
                            TextWrapping="NoWrap" />
                    </StackPanel>
                </StackPanel>
            </ui:SettingsCard>

            <ui:SettingsCard
                Margin="0 14 0 0"
                Description="Disable Flow Launcher activation when a full screen application is active (Recommended for games)."
                Header="Ignore hotkeys in fullscreen mode">
                <ui:SettingsCard.HeaderIcon>
                    <ui:FontIcon Glyph="&#xe7fc;" />
                </ui:SettingsCard.HeaderIcon>

                <ui:ToggleSwitch
                    IsOn="{Binding Settings.IgnoreHotkeysOnFullscreen}"
                    OffContent="Off"
                    OnContent="On" />
            </ui:SettingsCard>

            <ui:SettingsCard
                Margin="0 14 0 0"
                Description="Always open preview panel when Flow activates. Press {0} to toggle preview."
                Header="Always Preview">
                <ui:SettingsCard.HeaderIcon>
                    <ui:FontIcon Glyph="&#xe8a1;" />
                </ui:SettingsCard.HeaderIcon>

                <ui:ToggleSwitch
                    IsOn="{Binding Settings.AlwaysPreview}"
                    OffContent="Off"
                    OnContent="On"
                    ToolTip="{Binding AlwaysPreviewToolTip}" />
            </ui:SettingsCard>

            <ui:SettingsCard
                Margin="0 14 0 0"
                Description="Changes minimum match score required for results."
                Header="Query Search Precision">

                <ComboBox
                    MaxWidth="200"
                    DisplayMemberPath="Description"
                    ItemsSource="{Binding SearchPrecisionScores}"
                    SelectedValue="{Binding Settings.QuerySearchPrecision}"
                    SelectedValuePath="Value" />
            </ui:SettingsCard>

            <ui:SettingsCard
                Margin="0 4 0 0"
                Description="Show/Hide previous results when Flow Launcher is reactivated."
                Header="Last Query Style">
                <ComboBox
                    MinWidth="210"
                    DisplayMemberPath="Description"
                    ItemsSource="{Binding LastQueryMode}"
                    SelectedValue="{Binding Settings.LastQueryMode}"
                    SelectedValuePath="Value" />
            </ui:SettingsCard>

            <ui:SettingsCard
                Margin="0 14 0 0"
                Description="Show home page results when query text is empty."
                Header="Home Page">
                <ui:SettingsCard.HeaderIcon>
                    <ui:FontIcon Glyph="&#xE80F;" />
                </ui:SettingsCard.HeaderIcon>

                <ui:ToggleSwitch
                    IsOn="{Binding Settings.ShowHomePage}"
                    OffContent="Off"
                    OnContent="On" />
            </ui:SettingsCard>
        </VirtualizingStackPanel>
    </ui:ScrollViewerEx>
</ui:Page>