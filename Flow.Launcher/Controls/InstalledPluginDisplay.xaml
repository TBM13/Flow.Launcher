<UserControl
    x:Class="Flow.Launcher.Controls.InstalledPluginDisplay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Flow.Launcher.Settings.Pages"
    xmlns:pluginsdk="http://schemas.flowlauncher.com/pluginsdk"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:vm="clr-namespace:Flow.Launcher.ViewModel"
    d:DataContext="{d:DesignInstance vm:PluginViewModel}"
    d:DesignHeight="300"
    d:DesignWidth="300"
    mc:Ignorable="d">
    <ui:SettingsExpander
        x:Name="PluginExpander"
        Description="{Binding PluginMetadata.Description}"
        Header="{Binding PluginMetadata.Name}"
        ToolTip="{Binding PluginMetadata.Version}">

        <ui:SettingsExpander.HeaderIcon>
            <Image Source="{Binding Image, Mode=OneWay}" />
        </ui:SettingsExpander.HeaderIcon>

        <ui:SettingsExpander.Content>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{pluginsdk:VisibleWhen {Binding DataContext.SelectedDisplayMode, RelativeSource={RelativeSource AncestorType=ui:ItemsRepeater}},
                                                       IsEqualTo={x:Static pages:PluginDisplayMode.Priority}}">
                    <TextBlock
                        Margin="0 0 8 0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Text="Priority" />
                    <ui:NumberBox
                        MinWidth="120"
                        Margin="0 0 8 0"
                        Maximum="999"
                        Minimum="-999"
                        SpinButtonPlacementMode="Inline"
                        ToolTip="Change Plugin Results Priority"
                        ValueChanged="NumberBox_OnValueChanged"
                        Value="{Binding Priority, Mode=TwoWay}" />
                </StackPanel>

                <ui:ToggleSwitch
                    Margin="0 0 8 0"
                    IsOn="{Binding PluginHomeState}"
                    Visibility="{pluginsdk:VisibleWhen {Binding DataContext.SelectedDisplayMode, RelativeSource={RelativeSource AncestorType=ui:ItemsRepeater}},
                                                       IsEqualTo={x:Static pages:PluginDisplayMode.HomeOnOff}}" />

                <ui:ToggleSwitch
                    Margin="0 0 8 0"
                    IsOn="{Binding PluginState}"
                    Visibility="{pluginsdk:VisibleWhen {Binding DataContext.SelectedDisplayMode, RelativeSource={RelativeSource AncestorType=ui:ItemsRepeater}},
                                                       IsEqualTo={x:Static pages:PluginDisplayMode.OnOff}}" />
            </StackPanel>
        </ui:SettingsExpander.Content>

        <ui:SettingsExpander.Items>
            <ui:SettingsCard Padding="0" ContentAlignment="Vertical">
                <StackPanel>
                    <!--  Action keyword setting  -->
                    <DockPanel Margin="70 13.5 18 13.5">
                        <ui:FontIcon
                            Margin="{StaticResource SettingPanelItemRightMargin}"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Left"
                            Glyph="&#xe819;" />
                        <TextBlock
                            Margin="{StaticResource SettingPanelItemRightMargin}"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Left"
                            Text="Action keyword" />
                        <Button
                            MinWidth="100"
                            Margin="0 -4.5 0 -4.5"
                            HorizontalAlignment="Right"
                            Command="{Binding SetActionKeywordsCommand}"
                            Content="{Binding ActionKeywordsText}"
                            DockPanel.Dock="Right"
                            FontWeight="Bold"
                            ToolTip="Change Action Keywords" />
                    </DockPanel>

                    <!--  Custom plugin settings  -->
                    <ContentControl x:Name="PluginSettingsControl" VerticalAlignment="Stretch" />

                    <!--  Plugin info  -->
                    <Border
                        Margin="0 5 0 0"
                        Padding="15 10"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Color00B}"
                        BorderBrush="{DynamicResource Color03B}"
                        BorderThickness="0 1 0 0"
                        CornerRadius="0 0 5 5"
                        SnapsToDevicePixels="True">
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <TextBlock
                                Margin="10 0 0 0"
                                VerticalAlignment="center"
                                FontSize="11"
                                Foreground="{DynamicResource SystemControlForegroundChromeGrayBrush}"
                                Text="by" />
                            <TextBlock
                                Margin="5 0 0 0"
                                VerticalAlignment="center"
                                FontSize="11"
                                Foreground="{DynamicResource SystemControlForegroundChromeGrayBrush}"
                                Text="{Binding PluginMetadata.Author}" />
                            <TextBlock
                                Margin="10 0 0 0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{DynamicResource SystemControlForegroundChromeGrayBrush}"
                                Text="|" />
                            <TextBlock
                                Margin="10 0 5 0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{DynamicResource SystemControlForegroundChromeGrayBrush}"
                                Text="{Binding Version}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:SettingsCard>
        </ui:SettingsExpander.Items>
    </ui:SettingsExpander>
</UserControl>
