<UserControl
    x:Class="Flow.Launcher.Controls.InstalledPluginDisplay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pluginsdk="http://schemas.flowlauncher.com/pluginsdk"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:vm="clr-namespace:Flow.Launcher.ViewModel"
    d:DataContext="{d:DesignInstance vm:PluginViewModel}"
    d:DesignHeight="300"
    d:DesignWidth="300"
    mc:Ignorable="d">
    <UserControl.Resources>
        <pluginsdk:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <ui:SettingsExpander
        ClipToBounds="True"
        Description="{Binding PluginMetadata.Description}"
        Header="{Binding PluginMetadata.Name}"
        IsExpanded="{Binding Mode=TwoWay, Path=IsExpanded}"
        SnapsToDevicePixels="True"
        ToolTip="{Binding PluginMetadata.Version}">

        <ui:SettingsExpander.HeaderIcon>
            <Image Source="{Binding Image, Mode=OneWay}" />
        </ui:SettingsExpander.HeaderIcon>

        <ui:SettingsExpander.Content>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <StackPanel
                    x:Name="PriorityControl"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{Binding DataContext.IsPrioritySelected, RelativeSource={RelativeSource AncestorType=ui:ItemsRepeater}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock
                        Margin="0 0 8 0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Text="Priority" />
                    <ui:NumberBox
                        MinWidth="120"
                        Margin="0 0 8 0"
                        Maximum="999"
                        Minimum="-999"
                        SpinButtonPlacementMode="Inline"
                        ToolTip="Change Plugin Results Priority"
                        ValueChanged="NumberBox_OnValueChanged"
                        Value="{Binding Priority, Mode=TwoWay}" />
                </StackPanel>

                <!--  Put OnOffControl after PriorityControl so that it can display correctly  -->
                <ui:ToggleSwitch
                    x:Name="HomeOnOffControl"
                    Margin="0 0 8 0"
                    HorizontalAlignment="Right"
                    IsEnabled="{Binding HomeEnabled}"
                    IsOn="{Binding PluginHomeState}"
                    ToolTip="This can only be edited if plugin supports Home feature and Home Page is enabled."
                    Visibility="{Binding DataContext.IsHomeOnOffSelected, RelativeSource={RelativeSource AncestorType=ui:ItemsRepeater}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <ui:ToggleSwitch
                    x:Name="OnOffControl"
                    Margin="0 0 8 0"
                    IsOn="{Binding PluginState}"
                    Visibility="{Binding DataContext.IsOnOffSelected, RelativeSource={RelativeSource AncestorType=ui:ItemsRepeater}, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </ui:SettingsExpander.Content>

        <ui:SettingsExpander.Items>
            <ui:SettingsCard
                Margin="0"
                Padding="0"
                ContentAlignment="Vertical">
                <StackPanel>
                    <!--  Action keyword setting  -->
                    <DockPanel Margin="{StaticResource SettingPanelMargin}">
                        <ui:FontIcon
                            Margin="{StaticResource SettingPanelItemRightMargin}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Left"
                            Glyph="&#xe819;" />
                        <TextBlock
                            Margin="{StaticResource SettingPanelItemRightMargin}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Left"
                            Text="Action keyword" />
                        <!--  Here Margin="0 -4.5 0 -4.5" is to remove redundant top bottom margin from Margin="{StaticResource SettingPanelMargin}"  -->
                        <Button
                            Width="auto"
                            MinWidth="100"
                            Margin="0 -4.5 0 -4.5"
                            HorizontalAlignment="Right"
                            Command="{Binding SetActionKeywordsCommand}"
                            Content="{Binding ActionKeywordsText}"
                            Cursor="Hand"
                            DockPanel.Dock="Right"
                            FontWeight="Bold"
                            ToolTip="Change Action Keywords" />
                    </DockPanel>

                    <!--  Custom plugin settings  -->
                    <ContentControl
                        Margin="0"
                        Padding="1"
                        VerticalAlignment="Stretch"
                        Content="{Binding SettingControl}" />

                    <!--  Plugin info  -->
                    <Border
                        Margin="0"
                        Padding="15 10"
                        VerticalAlignment="Center"
                        BorderThickness="0 1 0 0"
                        CornerRadius="0 0 5 5"
                        Style="{DynamicResource SettingGroupBox}">
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <TextBlock
                                Margin="10 0 0 0"
                                VerticalAlignment="center"
                                FontSize="11"
                                Foreground="{DynamicResource PluginInfoColor}"
                                Text="by" />
                            <TextBlock
                                Margin="5 0 0 0"
                                VerticalAlignment="center"
                                FontSize="11"
                                Foreground="{DynamicResource PluginInfoColor}"
                                Text="{Binding PluginMetadata.Author}" />
                            <TextBlock
                                Margin="10 0 0 0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{DynamicResource PluginInfoColor}"
                                Text="|" />
                            <TextBlock
                                Margin="10 0 5 0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{DynamicResource PluginInfoColor}"
                                Text="{Binding Version}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ui:SettingsCard>
        </ui:SettingsExpander.Items>
    </ui:SettingsExpander>
</UserControl>
