<UserControl
    x:Class="Flow.Launcher.Controls.HotkeyDisplay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    mc:Ignorable="d">
    <Button
        Padding="5 0"
        ui:ControlHelper.CornerRadius="5"
        FontSize="13"
        FontWeight="Bold"
        Foreground="{DynamicResource TextFillColorInverseBrush}">
        <ItemsControl x:Name="KeysList">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="2 5 2 5"
                        Padding="10 5 10 5"
                        Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                        BorderThickness="1"
                        CornerRadius="5">
                        <TextBlock Text="{Binding}" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Button>
</UserControl>
