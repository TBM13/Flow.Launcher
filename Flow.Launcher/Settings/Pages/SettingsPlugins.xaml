<UserControl
    x:Class="Flow.Launcher.Settings.Pages.SettingsPlugins"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="clr-namespace:Flow.Launcher.Resources.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:local="clr-namespace:Flow.Launcher.Settings.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pluginsdk="http://schemas.flowlauncher.com/pluginsdk"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    d:DataContext="{d:DesignInstance local:SettingsPluginsViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FocusManager.FocusedElement="{Binding ElementName=PluginFilterTextbox}"
    KeyDown="SettingsPanePlugins_OnKeyDown"
    mc:Ignorable="d">
    <UserControl.Resources>
        <CollectionViewSource
            x:Key="PluginCollectionView"
            Filter="PluginCollectionView_OnFilter"
            Source="{Binding PluginViewModels}" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="73" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="5 18 0 0">
            <TextBlock
                Margin="0 5 0 0"
                DockPanel.Dock="Left"
                FontSize="30"
                Text="Plugins"
                TextAlignment="Left" />
            <ikw:SimpleStackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{DynamicResource Color15B}"
                    Text="Advanced Settings:" />
                <ComboBox
                    x:Name="DisplayModeComboBox"
                    Width="Auto"
                    Height="34"
                    MinWidth="150"
                    MaxWidth="150"
                    HorizontalContentAlignment="Left"
                    pluginsdk:EnumBinding.EnumType="{x:Type local:DisplayMode}"
                    Background="{DynamicResource Color00B}"
                    SelectedValue="{Binding SelectedDisplayMode, Mode=TwoWay}" />
                <Button
                    Width="34"
                    Height="34"
                    Padding="0"
                    Command="{Binding OpenHelperCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                    FontSize="14">
                    <ui:FontIcon FontSize="14" Glyph="&#xe9ce;" />
                </Button>
                <TextBox
                    Name="PluginFilterTextbox"
                    Width="150"
                    Height="34"
                    Margin="0 0 26 0"
                    VerticalContentAlignment="Center"
                    ui:ControlHelper.PlaceholderText="Search Plugin"
                    FontSize="14"
                    Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="Ctrl+F to search plugins"
                    ToolTipService.InitialShowDelay="200"
                    ToolTipService.Placement="Top" />
            </ikw:SimpleStackPanel>
        </DockPanel>

        <ui:ScrollViewerEx
            Grid.Row="1"
            Grid.Column="0"
            Background="{DynamicResource Color01B}"
            VerticalScrollBarVisibility="Auto"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingStackPanel.IsVirtualizing="True"
            VirtualizingStackPanel.VirtualizationMode="Recycling">
            <ui:ItemsRepeater
                Margin="5 0 0 10"
                ItemsSource="{Binding Source={StaticResource PluginCollectionView}}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SnapsToDevicePixels="True">
                <ui:ItemsRepeater.Layout>
                    <ui:StackLayout Orientation="Vertical" Spacing="5" />
                </ui:ItemsRepeater.Layout>
                <ui:ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <cc:InstalledPluginDisplay />
                    </DataTemplate>
                </ui:ItemsRepeater.ItemTemplate>
            </ui:ItemsRepeater>
        </ui:ScrollViewerEx>
    </Grid>
</UserControl>
