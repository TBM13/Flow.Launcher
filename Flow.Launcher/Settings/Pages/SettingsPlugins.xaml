<UserControl
    x:Class="Flow.Launcher.Settings.Pages.SettingsPlugins"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Flow.Launcher.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Flow.Launcher.Settings.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pluginsdk="http://schemas.flowlauncher.com/pluginsdk"
    d:DataContext="{d:DesignInstance local:SettingsPluginsViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <StackPanel>
        <DockPanel Margin="5 23 0 15">
            <TextBlock
                DockPanel.Dock="Left"
                FontSize="30"
                Text="Plugins" />
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Orientation="Horizontal">
                <TextBlock
                    Margin="0 0 8 0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Color15B}"
                    Text="Advanced Settings:" />
                <ComboBox
                    x:Name="DisplayModeComboBox"
                    Height="34"
                    MinWidth="150"
                    MaxWidth="150"
                    Margin="0 0 8 0"
                    HorizontalContentAlignment="Left"
                    ItemsSource="{Binding DisplayModeItems}"
                    SelectedValue="{Binding SelectedDisplayMode, Mode=TwoWay}"
                    SelectedValuePath="Value" />
                <Button
                    Width="34"
                    Height="34"
                    Padding="0"
                    Command="{Binding OpenHelperCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource Self}}">
                    <pluginsdk:FontIcon Glyph="&#xe9ce;" />
                </Button>
            </StackPanel>
        </DockPanel>

        <ItemsControl
            Focusable="False"
            ItemsSource="{Binding Plugins}"
            SnapsToDevicePixels="True">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <controls:InstalledPluginDisplay Margin="0 0 0 5" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
