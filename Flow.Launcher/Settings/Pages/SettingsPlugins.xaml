<UserControl
    x:Class="Flow.Launcher.Settings.Pages.SettingsPlugins"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Flow.Launcher.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:local="clr-namespace:Flow.Launcher.Settings.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    d:DataContext="{d:DesignInstance local:SettingsPluginsViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FocusManager.FocusedElement="{Binding ElementName=PluginFilterTextbox}"
    mc:Ignorable="d">
    <StackPanel>
        <DockPanel Margin="5 23 0 15">
            <TextBlock
                DockPanel.Dock="Left"
                FontSize="30"
                Text="Plugins" />
            <ikw:SimpleStackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Color15B}"
                    Text="Advanced Settings:" />
                <ComboBox
                    x:Name="DisplayModeComboBox"
                    Height="34"
                    MinWidth="150"
                    MaxWidth="150"
                    HorizontalContentAlignment="Left"
                    ItemsSource="{Binding DisplayModeItems}"
                    SelectedValuePath="Value"
                    SelectedValue="{Binding SelectedDisplayMode, Mode=TwoWay}" />
                <Button
                    Width="34"
                    Height="34"
                    Padding="0"
                    Command="{Binding OpenHelperCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource Self}}">
                    <ui:FontIcon Glyph="&#xe9ce;" />
                </Button>
            </ikw:SimpleStackPanel>
        </DockPanel>

        <ui:ItemsRepeater
            ItemsSource="{Binding Plugins}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            SnapsToDevicePixels="True">
            <ui:ItemsRepeater.Layout>
                <ui:StackLayout Orientation="Vertical" Spacing="5" />
            </ui:ItemsRepeater.Layout>
            <ui:ItemsRepeater.ItemTemplate>
                <DataTemplate>
                    <controls:InstalledPluginDisplay />
                </DataTemplate>
            </ui:ItemsRepeater.ItemTemplate>
        </ui:ItemsRepeater>
    </StackPanel>
</UserControl>
