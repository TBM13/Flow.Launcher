<UserControl
    x:Class="Flow.Launcher.Settings.Pages.SettingsAbout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Flow.Launcher.Settings.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pluginsdk="http://schemas.flowlauncher.com/pluginsdk"
    d:DataContext="{d:DesignInstance Type=local:SettingsAboutViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <StackPanel>
        <TextBlock
            Margin="5 23 0 15"
            FontSize="30"
            Text="About" />

        <pluginsdk:SettingsCard Description="Version" Header="{Binding Version}">
            <pluginsdk:SettingsCard.HeaderIcon>
                <pluginsdk:FontIcon Glyph="&#xe946;" />
            </pluginsdk:SettingsCard.HeaderIcon>
        </pluginsdk:SettingsCard>

        <pluginsdk:SettingsCard Margin="0 4 0 0" Header="Icons">
            <pluginsdk:SettingsCard.HeaderIcon>
                <pluginsdk:FontIcon Glyph="&#xE8FE;" />
            </pluginsdk:SettingsCard.HeaderIcon>

            <TextBlock VerticalAlignment="Center">
                <Hyperlink NavigateUri="https://icons8.com/" RequestNavigate="Hyperlink_OnRequestNavigate">icons8.com</Hyperlink>
            </TextBlock>
        </pluginsdk:SettingsCard>

        <pluginsdk:SettingsCard Margin="0 14 0 0" Header="DevTools">
            <pluginsdk:SettingsCard.HeaderIcon>
                <pluginsdk:FontIcon Glyph="&#xf12b;" />
            </pluginsdk:SettingsCard.HeaderIcon>

            <StackPanel Orientation="Horizontal">
                <Button
                    x:Name="ClearCacheButton"
                    Margin="0 0 12 0"
                    Command="{Binding AskClearCacheFolderConfirmationCommand}"
                    Content="{Binding CacheFolderSize}" />
                <Button
                    Height="{Binding ElementName=ClearCacheButton, Path=ActualHeight}"
                    Click="OpenFoldersButton_OnClick">
                    <pluginsdk:FontIcon Glyph="&#xec7a;" />
                    <Button.ContextMenu>
                        <ContextMenu Placement="Bottom">
                            <MenuItem Command="{Binding OpenSettingsFolderCommand}" Header="Setting Folder">
                                <MenuItem.Icon>
                                    <pluginsdk:FontIcon Glyph="&#xe8b7;" />
                                </MenuItem.Icon>
                            </MenuItem>

                            <MenuItem Command="{Binding OpenCacheFolderCommand}" Header="Cache Folder">
                                <MenuItem.Icon>
                                    <pluginsdk:FontIcon Glyph="&#xe8b7;" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </pluginsdk:SettingsCard>
    </StackPanel>
</UserControl>
