<UserControl
    x:Class="Flow.Launcher.Settings.Pages.SettingsGeneral"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Flow.Launcher.Settings.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pluginsdk="http://schemas.flowlauncher.com/pluginsdk"
    xmlns:settings="clr-namespace:Flow.Launcher.Core.Settings;assembly=Flow.Launcher.Core"
    d:DataContext="{d:DesignInstance local:SettingsGeneralViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <StackPanel>
        <TextBlock
            Margin="5 23 0 15"
            FontSize="30"
            Text="General" />

        <pluginsdk:SettingsCard Description="Automatically launch Flow Launcher when Windows starts." Header="Start Flow Launcher on system startup">
            <pluginsdk:SettingsCard.HeaderIcon>
                <pluginsdk:FontIcon Glyph="&#xe7e8;" />
            </pluginsdk:SettingsCard.HeaderIcon>

            <pluginsdk:ToggleSwitch IsOn="{Binding Settings.StartOnSystemStartup}" />
        </pluginsdk:SettingsCard>

        <pluginsdk:SettingsCard Margin="0 12 0 0" Header="Hide Flow Launcher when focus is lost">
            <pluginsdk:ToggleSwitch IsOn="{Binding Settings.HideOnLostFocus}" />
        </pluginsdk:SettingsCard>

        <pluginsdk:SettingsCard
            Margin="0 4 0 0"
            Description="Temporarily show the taskbar when Flow Launcher is opened, useful for auto-hidden taskbars."
            Header="Show taskbar when Flow Launcher is opened">
            <pluginsdk:ToggleSwitch IsOn="{Binding Settings.ShowTaskbarWhenOpened}" />
        </pluginsdk:SettingsCard>

        <pluginsdk:SettingsCard Margin="0 4 0 0" Header="Search Window Location">
            <pluginsdk:SettingsCard.HeaderIcon>
                <pluginsdk:FontIcon Glyph="&#xe7f4;" />
            </pluginsdk:SettingsCard.HeaderIcon>
            <StackPanel Orientation="Horizontal">
                <ComboBox
                    MinWidth="220"
                    ItemsSource="{Binding DisplayItems}"
                    SelectedValue="{Binding Settings.Display}"
                    SelectedValuePath="Value" />
                <ComboBox
                    MinWidth="100"
                    Margin="18 0 0 0"
                    ItemsSource="{Binding ScreenNumbers}"
                    SelectedValue="{Binding Settings.DisplayNumber}"
                    Visibility="{Binding Settings.Display, Converter={StaticResource VisibleWhenEquals}, ConverterParameter={x:Static settings:DisplayType.Custom}}" />
            </StackPanel>
        </pluginsdk:SettingsCard>

        <pluginsdk:SettingsCard
            Margin="0 4 0 0"
            Header="Search Window Position on Monitor"
            Visibility="{Binding Settings.Display, Converter={StaticResource CollapsedWhenEquals}, ConverterParameter={x:Static settings:DisplayType.RememberLastDisplay}}">
            <pluginsdk:SettingsCard.HeaderIcon>
                <pluginsdk:FontIcon Glyph="&#xe7f4;" />
            </pluginsdk:SettingsCard.HeaderIcon>

            <StackPanel Orientation="Horizontal">
                <ComboBox
                    MinWidth="160"
                    ItemsSource="{Binding DisplayPositionItems}"
                    SelectedValue="{Binding Settings.DisplayPosition}"
                    SelectedValuePath="Value" />

                <StackPanel
                    Margin="18 0 0 0"
                    Orientation="Horizontal"
                    Visibility="{Binding Settings.DisplayPosition, Converter={StaticResource VisibleWhenEquals}, ConverterParameter={x:Static settings:DisplayPosition.Custom}}">

                    <TextBox MinWidth="80" Text="{Binding Settings.CustomDisplayPositionLeft}" />
                    <TextBlock Margin="10 0 10 0" Text="x" />
                    <TextBox
                        MinWidth="80"
                        Text="{Binding Settings.CustomDisplayPositionTop}"
                        TextWrapping="NoWrap" />
                </StackPanel>
            </StackPanel>
        </pluginsdk:SettingsCard>

        <pluginsdk:SettingsCard
            Margin="0 14 0 0"
            Description="Disable Flow Launcher activation when a full screen application is active (Recommended for games)."
            Header="Ignore hotkeys in fullscreen mode">
            <pluginsdk:SettingsCard.HeaderIcon>
                <pluginsdk:FontIcon Glyph="&#xe7fc;" />
            </pluginsdk:SettingsCard.HeaderIcon>

            <pluginsdk:ToggleSwitch IsOn="{Binding Settings.IgnoreHotkeysOnFullscreen}" />
        </pluginsdk:SettingsCard>

        <pluginsdk:SettingsCard
            Margin="0 14 0 0"
            Description="Always open preview panel when Flow activates. Press {0} to toggle preview."
            Header="Always Preview">
            <pluginsdk:SettingsCard.HeaderIcon>
                <pluginsdk:FontIcon Glyph="&#xe8a1;" />
            </pluginsdk:SettingsCard.HeaderIcon>

            <pluginsdk:ToggleSwitch IsOn="{Binding Settings.AlwaysPreview}" ToolTip="{Binding AlwaysPreviewToolTip}" />
        </pluginsdk:SettingsCard>

        <pluginsdk:SettingsCard
            Margin="0 14 0 0"
            Description="Changes minimum match score required for results."
            Header="Query Search Precision">

            <ComboBox
                MaxWidth="200"
                ItemsSource="{Binding SearchPrecisionItems}"
                SelectedValue="{Binding Settings.QuerySearchPrecision}"
                SelectedValuePath="Value" />
        </pluginsdk:SettingsCard>

        <pluginsdk:SettingsCard
            Margin="0 4 0 0"
            Description="Show/Hide previous results when Flow Launcher is reactivated."
            Header="Last Query Style">
            <ComboBox
                MinWidth="210"
                ItemsSource="{Binding LastQueryModeItems}"
                SelectedValue="{Binding Settings.LastQueryMode}"
                SelectedValuePath="Value" />
        </pluginsdk:SettingsCard>

        <pluginsdk:SettingsCard
            Margin="0 14 0 0"
            Description="Show home page results when query text is empty."
            Header="Home Page">
            <pluginsdk:SettingsCard.HeaderIcon>
                <pluginsdk:FontIcon Glyph="&#xE80F;" />
            </pluginsdk:SettingsCard.HeaderIcon>

            <pluginsdk:ToggleSwitch IsOn="{Binding Settings.ShowHomePage}" />
        </pluginsdk:SettingsCard>
    </StackPanel>
</UserControl>
