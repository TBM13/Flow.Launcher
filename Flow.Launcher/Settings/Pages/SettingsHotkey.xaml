<UserControl
    x:Class="Flow.Launcher.Settings.Pages.SettingsHotkey"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Flow.Launcher.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hotkeys="clr-namespace:Flow.Launcher.Core.Hotkeys;assembly=Flow.Launcher.Core"
    xmlns:local="clr-namespace:Flow.Launcher.Settings.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:userSettings="clr-namespace:Flow.Launcher.Core.UserSettings;assembly=Flow.Launcher.Core"
    d:DataContext="{d:DesignInstance local:SettingsHotkeyViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <StackPanel>
        <TextBlock
            Margin="5 23 0 15"
            FontSize="30"
            Text="Hotkeys" />

        <ui:SettingsExpander Description="Enter shortcut to show/hide Flow Launcher." Header="Open Flow Launcher">
            <ui:SettingsExpander.HeaderIcon>
                <ui:FontIcon Glyph="&#xeda7;" />
            </ui:SettingsExpander.HeaderIcon>

            <controls:HotkeyControl HotkeyInfo="{x:Static hotkeys:DefaultHotkeys.ToggleFlowLauncher}" />

            <ui:SettingsExpander.Items>
                <ui:SettingsCard Description="Show Flow Launcher with a magic query depending on the computer's context (e.g. the explorer's path if a folder is opened and focused)." Header="Magic Query">
                    <ui:SettingsCard.HeaderIcon>
                        <ui:FontIcon Glyph="&#xeda7;" />
                    </ui:SettingsCard.HeaderIcon>

                    <controls:HotkeyControl HotkeyInfo="{x:Static hotkeys:DefaultHotkeys.MagicQuery}" />
                </ui:SettingsCard>
            </ui:SettingsExpander.Items>
        </ui:SettingsExpander>

        <ui:SettingsCard
            Margin="0 4 0 0"
            Description="Enter shortcut to show/hide preview in search window."
            Header="Toggle Preview">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Glyph="&#xe8a1;" />
            </ui:SettingsCard.HeaderIcon>

            <controls:HotkeyControl HotkeyInfo="{x:Static hotkeys:DefaultHotkeys.TogglePreview}" />
        </ui:SettingsCard>

        <ui:SettingsExpander
            Margin="0 14 0 0"
            Description="List of currently registered hotkeys"
            Header="Hotkey Presets">
            <ui:SettingsExpander.HeaderIcon>
                <ui:FontIcon Glyph="&#xf0e2;" />
            </ui:SettingsExpander.HeaderIcon>

            <ui:SettingsExpander.Items>
                <ui:SettingsCard Header="Open Containing Folder">
                    <ui:SettingsCard.HeaderIcon>
                        <ui:FontIcon Glyph="&#xe8b7;" />
                    </ui:SettingsCard.HeaderIcon>

                    <controls:HotkeyDisplay Keys="Ctrl+Enter" />
                </ui:SettingsCard>
                <ui:SettingsCard Header="Run As Admin">
                    <ui:SettingsCard.HeaderIcon>
                        <ui:FontIcon Glyph="&#xe7ef;" />
                    </ui:SettingsCard.HeaderIcon>

                    <controls:HotkeyDisplay Keys="Ctrl+Shift+Enter" />
                </ui:SettingsCard>
                <ui:SettingsCard Header="Copy File Path">
                    <ui:SettingsCard.HeaderIcon>
                        <ui:FontIcon Glyph="&#xe8c8;" />
                    </ui:SettingsCard.HeaderIcon>

                    <controls:HotkeyDisplay Keys="Ctrl+Shift+C" />
                </ui:SettingsCard>
                <ui:SettingsCard Header="Open Context Menu">
                    <ui:SettingsCard.HeaderIcon>
                        <ui:FontIcon Glyph="&#xede3;" />
                    </ui:SettingsCard.HeaderIcon>

                    <controls:HotkeyDisplay Keys="Shift+Enter" />
                </ui:SettingsCard>
                <ui:SettingsCard Header="Open Native Context Menu">
                    <ui:SettingsCard.HeaderIcon>
                        <ui:FontIcon Glyph="&#xede3;" />
                    </ui:SettingsCard.HeaderIcon>

                    <controls:HotkeyDisplay Keys="Alt+Enter" />
                </ui:SettingsCard>
                <ui:SettingsCard Header="Toggle Game Mode">
                    <ui:SettingsCard.HeaderIcon>
                        <ui:FontIcon Glyph="&#xe7fc;" />
                    </ui:SettingsCard.HeaderIcon>

                    <controls:HotkeyDisplay Keys="Ctrl+F12" />
                </ui:SettingsCard>
                <ui:SettingsCard Header="Refresh Search Results">
                    <ui:SettingsCard.HeaderIcon>
                        <ui:FontIcon Glyph="&#xe72c;" />
                    </ui:SettingsCard.HeaderIcon>

                    <controls:HotkeyDisplay Keys="Ctrl+R" />
                </ui:SettingsCard>
                <ui:SettingsCard Description="Use when require plugins to reload and update their existing data." Header="Reload Plugins Data">
                    <ui:SettingsCard.HeaderIcon>
                        <ui:FontIcon Glyph="&#xe72c;" />
                    </ui:SettingsCard.HeaderIcon>

                    <controls:HotkeyDisplay Keys="F5" />
                </ui:SettingsCard>
                <ui:SettingsCard Header="Previous Page">
                    <ui:SettingsCard.HeaderIcon>
                        <ui:FontIcon Glyph="&#xf0ad;" />
                    </ui:SettingsCard.HeaderIcon>

                    <controls:HotkeyControl HotkeyInfo="{x:Static hotkeys:DefaultHotkeys.SelectPreviousPage}" />
                </ui:SettingsCard>
                <ui:SettingsCard Header="Next Page">
                    <ui:SettingsCard.HeaderIcon>
                        <ui:FontIcon Glyph="&#xf0ae;" />
                    </ui:SettingsCard.HeaderIcon>

                    <controls:HotkeyControl HotkeyInfo="{x:Static hotkeys:DefaultHotkeys.SelectNextPage}" />
                </ui:SettingsCard>

                <ui:SettingsCard Header="Quick Adjust Window Width">
                    <ui:SettingsCard.HeaderIcon>
                        <ui:FontIcon Glyph="&#xe7ea;" />
                    </ui:SettingsCard.HeaderIcon>

                    <StackPanel Orientation="Horizontal">
                        <controls:HotkeyDisplay Keys="Ctrl+[" />
                        <controls:HotkeyDisplay Margin="4 0 0 0" Keys="Ctrl+]" />
                    </StackPanel>
                </ui:SettingsCard>
                <ui:SettingsCard Header="Quick Adjust Window Height">
                    <ui:SettingsCard.HeaderIcon>
                        <ui:FontIcon Glyph="&#xe7eb;" />
                    </ui:SettingsCard.HeaderIcon>

                    <StackPanel Orientation="Horizontal">
                        <controls:HotkeyDisplay Keys="Ctrl+Plus" />
                        <controls:HotkeyDisplay Margin="4 0 0 0" Keys="Ctrl+Minus" />
                    </StackPanel>
                </ui:SettingsCard>
            </ui:SettingsExpander.Items>
        </ui:SettingsExpander>

        <ui:SettingsCard
            Margin="0 14 0 0"
            Description="Runs autocomplete for the selected items."
            Header="Auto Complete">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Glyph="&#xe893;" />
            </ui:SettingsCard.HeaderIcon>

            <controls:HotkeyControl HotkeyInfo="{x:Static hotkeys:DefaultHotkeys.Autocomplete}" />
        </ui:SettingsCard>

        <ui:SettingsCard Margin="0 4 0 0" Header="Select Previous Item">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Glyph="&#xe74a;" />
            </ui:SettingsCard.HeaderIcon>

            <controls:HotkeyControl HotkeyInfo="{x:Static hotkeys:DefaultHotkeys.SelectPreviousResult}" />
        </ui:SettingsCard>

        <ui:SettingsCard Margin="0 4 0 0" Header="Select Next Item">
            <ui:SettingsCard.HeaderIcon>
                <ui:FontIcon Glyph="&#xe74b;" />
            </ui:SettingsCard.HeaderIcon>

            <controls:HotkeyControl HotkeyInfo="{x:Static hotkeys:DefaultHotkeys.SelectNextResult}" />
        </ui:SettingsCard>

        <ui:SettingsExpander Margin="0 20 0 0" Header="Custom Query Hotkeys">
            <ui:SettingsExpander.HeaderIcon>
                <ui:FontIcon Glyph="&#xf26c;" />
            </ui:SettingsExpander.HeaderIcon>

            <ui:SettingsExpander.Items>
                <ui:SettingsCard Padding="0" ContentAlignment="Vertical">
                    <StackPanel Margin="18 18 18 0">
                        <ListView
                            MinHeight="160"
                            Margin="0"
                            BorderBrush="DarkGray"
                            BorderThickness="1"
                            ItemsSource="{Binding Settings.CustomPluginHotkeys}"
                            SelectedItem="{Binding SelectedCustomPluginHotkey}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="180" Header="Hotkey">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="userSettings:CustomPluginHotkey">
                                                <TextBlock Text="{Binding Hotkey}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="430" Header="Query">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="userSettings:CustomPluginHotkey">
                                                <TextBlock Text="{Binding ActionKeyword}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button
                                MinWidth="100"
                                Margin="10"
                                Command="{Binding CustomHotkeyDeleteCommand}"
                                Content="Delete" />
                            <Button
                                MinWidth="100"
                                Margin="10"
                                Command="{Binding CustomHotkeyEditCommand}"
                                Content="Edit" />
                            <Button
                                MinWidth="100"
                                Margin="10 10 0 10"
                                Command="{Binding CustomHotkeyAddCommand}"
                                Content="Add" />
                        </StackPanel>
                    </StackPanel>
                </ui:SettingsCard>
            </ui:SettingsExpander.Items>
        </ui:SettingsExpander>

        <ui:SettingsExpander Margin="0 4 0 0" Header="Custom Query Shortcuts">
            <ui:SettingsExpander.HeaderIcon>
                <ui:FontIcon Glyph="&#xf26b;" />
            </ui:SettingsExpander.HeaderIcon>

            <ui:SettingsExpander.Items>
                <ui:SettingsCard Padding="0" ContentAlignment="Vertical">
                    <StackPanel Margin="18 12 18 0">
                        <ListView
                            MinHeight="160"
                            Margin="0 6 0 0"
                            BorderBrush="DarkGray"
                            BorderThickness="1"
                            ItemsSource="{Binding Settings.CustomShortcuts}"
                            SelectedItem="{Binding SelectedCustomShortcut}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="180" Header="Shortcut">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type userSettings:CustomShortcutModel}">
                                                <TextBlock Text="{Binding Key}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="430" Header="Expansion">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type userSettings:CustomShortcutModel}">
                                                <TextBlock Text="{Binding Value}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <StackPanel
                            Margin="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                            <Button
                                MinWidth="100"
                                Margin="10"
                                Command="{Binding CustomShortcutDeleteCommand}"
                                Content="Delete" />
                            <Button
                                MinWidth="100"
                                Margin="10"
                                Command="{Binding CustomShortcutEditCommand}"
                                Content="Edit" />
                            <Button
                                MinWidth="100"
                                Margin="10 10 0 10"
                                Command="{Binding CustomShortcutAddCommand}"
                                Content="Add" />
                        </StackPanel>
                    </StackPanel>
                </ui:SettingsCard>
            </ui:SettingsExpander.Items>
        </ui:SettingsExpander>

        <ui:SettingsExpander Margin="0 4 0 14" Header="Built-in Shortcuts">
            <ui:SettingsExpander.HeaderIcon>
                <ui:FontIcon Glyph="&#xf158;" />
            </ui:SettingsExpander.HeaderIcon>

            <ui:SettingsExpander.Items>
                <ui:SettingsCard Padding="0" ContentAlignment="Vertical">
                    <ListView
                        MinHeight="160"
                        Margin="16 14 16 16"
                        BorderBrush="DarkGray"
                        BorderThickness="1"
                        ItemsSource="{Binding Settings.BuiltinShortcuts}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="180" Header="Shortcut">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type userSettings:BuiltinShortcutModel}">
                                            <TextBlock Text="{Binding Key}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="430" Header="Description">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type userSettings:BuiltinShortcutModel}">
                                            <TextBlock Text="{Binding Description}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </ui:SettingsCard>
            </ui:SettingsExpander.Items>
        </ui:SettingsExpander>
    </StackPanel>
</UserControl>