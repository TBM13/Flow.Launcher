<Window
    x:Class="Flow.Launcher.Settings.SettingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:Flow.Launcher.Settings.Pages"
    xmlns:setting="clr-namespace:Flow.Launcher.Settings"
    Title="Settings"
    Width="{Binding Settings.SettingWindowWidth, Mode=TwoWay}"
    Height="{Binding Settings.SettingWindowHeight, Mode=TwoWay}"
    MinWidth="940"
    MinHeight="600"
    d:DataContext="{d:DesignInstance setting:SettingViewModel}"
    Icon="pack://application:,,,/Images/app.ico"
    ResizeMode="CanResize"
    SnapsToDevicePixels="True"
    StateChanged="Window_StateChanged"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <Window.Resources>
        <DataTemplate DataType="{x:Type pages:SettingsGeneralViewModel}">
            <pages:SettingsGeneral />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:SettingsPluginsViewModel}">
            <pages:SettingsPlugins />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:SettingsThemeViewModel}">
            <pages:SettingsTheme />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:SettingsHotkeyViewModel}">
            <pages:SettingsHotkey />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:SettingsAboutViewModel}">
            <pages:SettingsAbout />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <StackPanel Margin="0 35 0 25" HorizontalAlignment="Center">
                <Image
                    Width="50"
                    Height="50"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    Source="pack://application:,,,/Images/app.png" />
                <TextBlock
                    Margin="0 12 0 0"
                    FontSize="14"
                    Text="Flow Launcher"
                    TextAlignment="Center" />
            </StackPanel>

            <ListBox
                Margin="8 0"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding Pages}"
                SelectedItem="{Binding CurrentPage, Mode=TwoWay}"
                SelectionChanged="NavigationView_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type pages:BaseSettingsPageViewModel}">
                        <StackPanel Margin="4 6" Orientation="Horizontal">
                            <Image
                                Width="18"
                                Height="18"
                                Margin="0 0 12 0"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="{Binding IconPath}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="14"
                                Text="{Binding Title}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <ScrollViewer
            x:Name="PageScrollViewer"
            Grid.Column="1"
            CanContentScroll="False"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <ContentControl
                Margin="6 0 24 24"
                Content="{Binding CurrentPage}"
                Focusable="False" />
        </ScrollViewer>
    </Grid>
</Window>
