<Window
    x:Class="Flow.Launcher.ActionKeywords"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Flow.Launcher.Resources.Controls"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    Title="Action keyword Setting"
    Width="450"
    ui:WindowHelper.UseModernWindowStyle="True"
    Background="{DynamicResource PopuBGColor}"
    Foreground="{DynamicResource PopupTextColor}"
    Icon="Images\app.png"
    Loaded="ActionKeyword_OnLoaded"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterScreen"
    WindowStyle="ToolWindow">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition Height="80" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="26 12 26 12"
            FontSize="20"
            FontWeight="SemiBold"
            Text="Action keyword Setting"
            TextAlignment="Left" />
        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="26 0 26 10"
            FontSize="14"
            Text="Enter the action keywords you like to use to start the plugin and use whitespace to divide them. Use * if you don't want to specify any, and the plugin will be triggered without any action keywords."
            TextAlignment="Left"
            TextWrapping="WrapWithOverflow" />

        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            Margin="26 0 10 0"
            VerticalAlignment="Center"
            FontSize="14"
            Text="Current action keyword" />
        <TextBox
            x:Name="tbOldActionKeyword"
            Grid.Row="2"
            Grid.Column="1"
            Margin="10 10 26 6"
            VerticalAlignment="Center"
            FontSize="14"
            FontWeight="SemiBold"
            Foreground="{DynamicResource Color05B}"
            IsReadOnly="True"
            Text="List of old keyword(s)" />

        <TextBlock
            Grid.Row="3"
            Grid.Column="0"
            Margin="26 6 10 12"
            VerticalAlignment="Center"
            FontSize="14"
            Text="New action keyword" />
        <TextBox
            x:Name="tbAction"
            Grid.Row="3"
            Grid.Column="1"
            Margin="10 6 26 10"
            VerticalAlignment="Center" />

        <Border
            Grid.Row="4"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0 10 0 0"
            Background="{DynamicResource PopupButtonAreaBGColor}"
            BorderBrush="{DynamicResource PopupButtonAreaBorderColor}"
            BorderThickness="0 1 0 0">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Button
                    x:Name="btnCancel"
                    Width="145"
                    Height="38"
                    Margin="10 0 10 0"
                    Click="BtnCancel_OnClick"
                    Content="Cancel" />
                <Button
                    x:Name="btnDone"
                    Width="145"
                    Height="38"
                    Margin="10 0 10 0"
                    Click="btnDone_OnClick"
                    Style="{StaticResource AccentButtonStyle}">
                    <TextBlock x:Name="lblAdd" Text="Done" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>